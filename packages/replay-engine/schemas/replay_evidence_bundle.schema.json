{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/replay-engine/replay_evidence_bundle.schema.json",
  "title": "Overlord ReplayEvidenceBundle",
  "type": "object",
  "required": [
    "replay_evidence_bundle_id",
    "schema_version",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "replay_mode",
    "source_replay_run_manifest_id",
    "source_replay_clock_id",
    "source_replay_read_plan_id",
    "source_replay_noop_run_summary_id",
    "source_manifest_path",
    "source_clock_path",
    "source_read_plan_path",
    "source_trace_path",
    "source_summary_path",
    "evidence_artifacts",
    "noop_run_totals",
    "consistency_checks",
    "status",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "replay_evidence_bundle_id": { "type": "string", "pattern": "^reb_" },
    "schema_version": { "const": "replay_evidence_bundle.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "replay_mode": { "enum": ["offline_fixture_replay"] },
    "source_replay_run_manifest_id": { "type": "string", "pattern": "^rrm_" },
    "source_replay_clock_id": { "type": "string", "pattern": "^rclk_" },
    "source_replay_read_plan_id": { "type": "string", "pattern": "^rrp_" },
    "source_replay_noop_run_summary_id": { "type": "string", "pattern": "^rnrs_" },
    "source_manifest_path": { "type": "string" },
    "source_clock_path": { "type": "string" },
    "source_read_plan_path": { "type": "string" },
    "source_trace_path": { "type": "string" },
    "source_summary_path": { "type": "string" },
    "evidence_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_type", "artifact_path", "schema_version", "record_count", "validation_command", "artifact_id"],
        "additionalProperties": false,
        "properties": {
          "artifact_type": {
            "enum": ["replay_run_manifest", "replay_clock", "replay_read_plan", "replay_trace", "replay_noop_run_summary"]
          },
          "artifact_path": { "type": "string" },
          "schema_version": { "type": "string" },
          "record_count": { "type": "integer", "minimum": 0 },
          "validation_command": { "type": "string" },
          "artifact_id": { "type": ["string", "null"] }
        }
      }
    },
    "noop_run_totals": {
      "type": "object",
      "required": ["total_trace_records", "total_records_read", "total_artifacts_read"],
      "additionalProperties": false,
      "properties": {
        "total_trace_records": { "type": "integer", "minimum": 0 },
        "total_records_read": { "type": "integer", "minimum": 0 },
        "total_artifacts_read": { "type": "integer", "minimum": 0 }
      }
    },
    "consistency_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_name", "status", "reason"],
        "additionalProperties": false,
        "properties": {
          "check_name": { "type": "string" },
          "status": { "enum": ["check_passed", "check_failed", "check_not_applicable"] },
          "reason": { "type": "string" }
        }
      }
    },
    "status": { "enum": ["evidence_bundle_ready", "evidence_bundle_rejected"] },
    "reason": { "type": "string" }
  }
}
