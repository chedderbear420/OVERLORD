{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/replay-engine/replay_read_plan.schema.json",
  "title": "Overlord ReplayReadPlan",
  "type": "object",
  "required": [
    "replay_read_plan_id",
    "schema_version",
    "source_replay_run_manifest_id",
    "source_manifest_path",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "replay_mode",
    "artifact_reads",
    "total_records_planned",
    "status",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "replay_read_plan_id": {
      "type": "string",
      "pattern": "^rrp_"
    },
    "schema_version": {
      "const": "replay_read_plan.v1"
    },
    "source_replay_run_manifest_id": {
      "type": "string",
      "pattern": "^rrm_"
    },
    "source_manifest_path": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "paper_only": {
      "const": true
    },
    "live_execution_allowed": {
      "const": false
    },
    "order_placement_allowed": {
      "const": false
    },
    "replay_mode": {
      "enum": ["offline_fixture_replay"]
    },
    "artifact_reads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "read_index",
          "artifact_type",
          "artifact_path",
          "record_count",
          "validation_command"
        ],
        "additionalProperties": false,
        "properties": {
          "read_index": {
            "type": "integer",
            "minimum": 0
          },
          "artifact_type": {
            "type": "string"
          },
          "artifact_path": {
            "type": "string"
          },
          "record_count": {
            "type": "integer",
            "minimum": 0
          },
          "validation_command": {
            "type": "string",
            "pattern": "^npm run "
          }
        }
      }
    },
    "total_records_planned": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": ["replay_read_plan_ready", "replay_read_plan_rejected"]
    },
    "reason": {
      "type": "string"
    }
  }
}
