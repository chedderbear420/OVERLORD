{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/replay-engine/replay_run_report.schema.json",
  "title": "Overlord ReplayRunReport",
  "type": "object",
  "required": [
    "replay_run_report_id",
    "schema_version",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "replay_mode",
    "source_replay_evidence_bundle_id",
    "source_replay_run_manifest_id",
    "source_replay_clock_id",
    "source_replay_read_plan_id",
    "source_replay_noop_run_summary_id",
    "total_artifacts_verified",
    "total_trace_records",
    "total_records_read",
    "total_artifacts_read",
    "consistency_status",
    "status",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "replay_run_report_id": { "type": "string", "pattern": "^rrr_" },
    "schema_version": { "const": "replay_run_report.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "replay_mode": { "enum": ["offline_fixture_replay"] },
    "source_replay_evidence_bundle_id": { "type": "string", "pattern": "^reb_" },
    "source_replay_run_manifest_id": { "type": "string", "pattern": "^rrm_" },
    "source_replay_clock_id": { "type": "string", "pattern": "^rclk_" },
    "source_replay_read_plan_id": { "type": "string", "pattern": "^rrp_" },
    "source_replay_noop_run_summary_id": { "type": "string", "pattern": "^rnrs_" },
    "total_artifacts_verified": { "type": "integer", "minimum": 0 },
    "total_trace_records": { "type": "integer", "minimum": 0 },
    "total_records_read": { "type": "integer", "minimum": 0 },
    "total_artifacts_read": { "type": "integer", "minimum": 0 },
    "consistency_status": { "enum": ["consistent", "inconsistent"] },
    "status": { "enum": ["replay_run_report_ready", "replay_run_report_rejected"] },
    "reason": { "type": "string" }
  }
}
