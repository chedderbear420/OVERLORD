{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/replay-engine/replay_run_manifest.schema.json",
  "title": "Overlord ReplayRunManifest",
  "type": "object",
  "required": [
    "replay_run_manifest_id",
    "schema_version",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "replay_mode",
    "artifacts",
    "validation_commands",
    "status",
    "reason"
  ],
  "properties": {
    "replay_run_manifest_id": {
      "type": "string",
      "pattern": "^rrm_"
    },
    "schema_version": {
      "const": "replay_run_manifest.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "paper_only": {
      "const": true
    },
    "live_execution_allowed": {
      "const": false
    },
    "order_placement_allowed": {
      "const": false
    },
    "replay_mode": {
      "enum": ["offline_fixture_replay"]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_type",
          "artifact_path",
          "schema_version",
          "validation_command",
          "record_count"
        ],
        "additionalProperties": false,
        "properties": {
          "artifact_type": {
            "enum": [
              "event_store_market_events",
              "market_state",
              "edge_signal",
              "risk_decision",
              "action_decision",
              "paper_ledger",
              "paper_exit",
              "paper_performance_summary"
            ]
          },
          "artifact_path": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "validation_command": {
            "type": "string",
            "pattern": "^npm run "
          },
          "record_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^npm run "
      }
    },
    "status": {
      "enum": ["manifest_ready", "manifest_rejected"]
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
