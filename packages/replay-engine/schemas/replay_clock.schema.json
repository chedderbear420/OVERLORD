{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/replay-engine/replay_clock.schema.json",
  "title": "Overlord ReplayClock",
  "type": "object",
  "required": [
    "replay_clock_id",
    "schema_version",
    "source_replay_run_manifest_id",
    "source_manifest_path",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "replay_mode",
    "clock_events",
    "status",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "replay_clock_id": {
      "type": "string",
      "pattern": "^rclk_"
    },
    "schema_version": {
      "const": "replay_clock.v1"
    },
    "source_replay_run_manifest_id": {
      "type": "string",
      "pattern": "^rrm_"
    },
    "source_manifest_path": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "paper_only": {
      "const": true
    },
    "live_execution_allowed": {
      "const": false
    },
    "order_placement_allowed": {
      "const": false
    },
    "replay_mode": {
      "enum": ["offline_fixture_replay"]
    },
    "clock_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "clock_index",
          "artifact_type",
          "artifact_path",
          "record_ref",
          "record_time",
          "record_id"
        ],
        "additionalProperties": false,
        "properties": {
          "clock_index": {
            "type": "integer",
            "minimum": 0
          },
          "artifact_type": {
            "type": "string"
          },
          "artifact_path": {
            "type": "string"
          },
          "record_ref": {
            "type": "string"
          },
          "record_time": {
            "type": "string",
            "format": "date-time"
          },
          "record_id": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "status": {
      "enum": ["replay_clock_ready", "replay_clock_rejected"]
    },
    "reason": {
      "type": "string"
    }
  }
}
