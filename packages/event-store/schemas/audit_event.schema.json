{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/event-store/audit_event.schema.json",
  "title": "Overlord Audit Event",
  "description": "Local audit record for evidence ingestion, validation, replay selection, and append-only correction workflows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "source",
    "captured_at",
    "received_at",
    "sequence_id",
    "audit_action",
    "audit_status",
    "actor",
    "reason"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9._:-]+$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^corr_[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "type": "string",
      "const": "audit_event.v1"
    },
    "source": {
      "type": "string",
      "enum": [
        "synthetic_fixture",
        "manual_import",
        "offline_recorder"
      ]
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "sequence_id": {
      "type": "integer",
      "minimum": 1
    },
    "subject_event_id": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9._:-]+$"
    },
    "audit_action": {
      "type": "string",
      "enum": [
        "record_appended",
        "record_validated",
        "record_rejected",
        "record_superseded",
        "fixture_loaded",
        "replay_input_selected"
      ]
    },
    "audit_status": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "blocked",
        "superseded",
        "info"
      ]
    },
    "actor": {
      "type": "string",
      "enum": [
        "offline_fixture",
        "local_validator",
        "replay_engine",
        "human_operator"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
