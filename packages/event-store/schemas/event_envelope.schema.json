{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/event-store/event_envelope.schema.json",
  "title": "Overlord Immutable Event Envelope",
  "description": "Append-only wrapper for raw market events, audit events, and future replay-safe evidence records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "event_type",
    "source",
    "captured_at",
    "received_at",
    "sequence_id",
    "payload_schema",
    "payload_hash",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9._:-]+$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^corr_[A-Za-z0-9._:-]+$"
    },
    "schema_version": {
      "type": "string",
      "const": "event_envelope.v1"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "market_event",
        "audit_event"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "synthetic_fixture",
        "manual_import",
        "offline_recorder"
      ]
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "sequence_id": {
      "type": "integer",
      "minimum": 1
    },
    "payload_schema": {
      "type": "string",
      "enum": [
        "market_event.v1",
        "audit_event.v1"
      ]
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "description": "Payload must validate against payload_schema. Cross-file schema validation is enforced by local validation tooling."
    },
    "ingest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "line_number": {
          "type": "integer",
          "minimum": 1
        },
        "append_mode": {
          "type": "string",
          "const": "append_only"
        }
      }
    }
  }
}
