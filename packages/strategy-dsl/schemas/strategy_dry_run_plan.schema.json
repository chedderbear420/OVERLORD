{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/strategy-dsl/strategy_dry_run_plan.schema.json",
  "title": "Overlord StrategyDryRunPlan",
  "type": "object",
  "required": [
    "strategy_dry_run_plan_id",
    "schema_version",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "strategy_definition_id",
    "strategy_run_intent_id",
    "strategy_run_manifest_id",
    "strategy_run_evidence_bundle_id",
    "source_strategy_definition_id",
    "source_strategy_run_intent_id",
    "source_strategy_run_manifest_id",
    "source_strategy_run_evidence_bundle_id",
    "replay_mode",
    "run_mode",
    "allowed_input_artifacts",
    "forbidden_outputs",
    "planned_observation_steps",
    "safety_constraints",
    "status",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "strategy_dry_run_plan_id": { "type": "string", "pattern": "^sdrp_" },
    "schema_version": { "const": "strategy_dry_run_plan.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "strategy_definition_id": { "type": "string", "pattern": "^sdef_" },
    "strategy_run_intent_id": { "type": "string", "pattern": "^sri_" },
    "strategy_run_manifest_id": { "type": "string", "pattern": "^srm_" },
    "strategy_run_evidence_bundle_id": { "type": "string", "pattern": "^sreb_" },
    "source_strategy_definition_id": { "type": "string", "pattern": "^sdef_" },
    "source_strategy_run_intent_id": { "type": "string", "pattern": "^sri_" },
    "source_strategy_run_manifest_id": { "type": "string", "pattern": "^srm_" },
    "source_strategy_run_evidence_bundle_id": { "type": "string", "pattern": "^sreb_" },
    "replay_mode": { "enum": ["offline_fixture_replay"] },
    "run_mode": { "enum": ["validation_only", "dry_run_planned"] },
    "allowed_input_artifacts": {
      "type": "array",
      "items": { "type": "object" }
    },
    "forbidden_outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "planned_observation_steps": {
      "type": "array",
      "items": { "type": "object" }
    },
    "safety_constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": { "enum": ["strategy_dry_run_plan_ready", "strategy_dry_run_plan_rejected"] },
    "reason": { "type": "string" }
  }
}
