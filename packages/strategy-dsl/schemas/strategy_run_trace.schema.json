{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/strategy-dsl/strategy_run_trace.schema.json",
  "title": "Overlord StrategyRunTrace",
  "type": "object",
  "required": [
    "strategy_run_trace_id",
    "schema_version",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "strategy_definition_id",
    "strategy_run_intent_id",
    "source_replay_run_manifest_id",
    "source_replay_evidence_bundle_id",
    "source_replay_clock_id",
    "source_replay_read_plan_id",
    "source_replay_trace_id",
    "replay_mode",
    "run_mode",
    "trace_event_type",
    "trace_index",
    "artifact_type",
    "artifact_path",
    "record_ref",
    "record_time",
    "record_id",
    "status",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "strategy_run_trace_id": { "type": "string", "pattern": "^srt_" },
    "schema_version": { "const": "strategy_run_trace.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "strategy_definition_id": { "type": "string", "pattern": "^sdef_" },
    "strategy_run_intent_id": { "type": "string", "pattern": "^sri_" },
    "source_replay_run_manifest_id": { "type": "string", "pattern": "^rrm_" },
    "source_replay_evidence_bundle_id": { "type": "string", "pattern": "^reb_" },
    "source_replay_clock_id": { "type": "string", "pattern": "^rclk_" },
    "source_replay_read_plan_id": { "type": "string", "pattern": "^rrp_" },
    "source_replay_trace_id": { "type": ["string", "null"] },
    "replay_mode": { "enum": ["offline_fixture_replay"] },
    "run_mode": { "enum": ["validation_only", "dry_run_planned"] },
    "trace_event_type": {
      "enum": [
        "noop_strategy_run_started",
        "noop_strategy_input_observed",
        "noop_strategy_run_completed",
        "noop_strategy_run_rejected"
      ]
    },
    "trace_index": { "type": "integer", "minimum": 0 },
    "artifact_type": { "type": "string" },
    "artifact_path": { "type": "string" },
    "record_ref": { "type": "string" },
    "record_time": { "type": "string", "format": "date-time" },
    "record_id": { "type": ["string", "null"] },
    "status": { "enum": ["strategy_trace_recorded", "strategy_trace_rejected"] },
    "reason": { "type": "string" }
  }
}
