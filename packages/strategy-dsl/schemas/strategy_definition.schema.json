{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/strategy-dsl/strategy_definition.schema.json",
  "title": "Overlord StrategyDefinition",
  "type": "object",
  "required": [
    "strategy_definition_id",
    "schema_version",
    "created_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "strategy_name",
    "strategy_version",
    "strategy_type",
    "description",
    "allowed_inputs",
    "forbidden_outputs",
    "parameters",
    "status",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "strategy_definition_id": { "type": "string", "pattern": "^sdef_" },
    "schema_version": { "const": "strategy_definition.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "strategy_name": { "type": "string" },
    "strategy_version": { "type": "string" },
    "strategy_type": { "enum": ["noop_strategy_contract", "rule_based_strategy_contract"] },
    "description": { "type": "string" },
    "allowed_inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["market_state", "edge_signal", "replay_trace", "replay_clock", "replay_read_plan"] }
    },
    "forbidden_outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "parameters": { "type": "object" },
    "status": { "enum": ["strategy_definition_ready", "strategy_definition_rejected"] },
    "reason": { "type": "string" }
  }
}
