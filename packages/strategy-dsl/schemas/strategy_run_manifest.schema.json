{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/strategy-dsl/strategy_run_manifest.schema.json",
  "title": "Overlord StrategyRunManifest",
  "type": "object",
  "required": [
    "strategy_run_manifest_id",
    "schema_version",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "strategy_definition_id",
    "strategy_run_intent_id",
    "replay_mode",
    "run_mode",
    "artifacts",
    "validation_commands",
    "status",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "strategy_run_manifest_id": { "type": "string", "pattern": "^srm_" },
    "schema_version": { "const": "strategy_run_manifest.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "strategy_definition_id": { "type": "string", "pattern": "^sdef_" },
    "strategy_run_intent_id": { "type": "string", "pattern": "^sri_" },
    "replay_mode": { "enum": ["offline_fixture_replay"] },
    "run_mode": { "enum": ["validation_only", "dry_run_planned"] },
    "artifacts": {
      "type": "array",
      "items": { "type": "object" }
    },
    "validation_commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": { "enum": ["strategy_run_manifest_ready", "strategy_run_manifest_rejected"] },
    "reason": { "type": "string" }
  }
}
