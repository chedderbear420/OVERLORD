{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overlord.strategy_observation_processing_contract.schema.json",
  "title": "StrategyObservationProcessingContract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "strategy_observation_processing_contract_id",
    "schema_version",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "strategy_definition_id",
    "strategy_run_intent_id",
    "strategy_observation_stack_closeout_checkpoint_id",
    "source_strategy_observation_stack_closeout_checkpoint_id",
    "source_strategy_observation_case_file_summary_id",
    "source_strategy_observation_evidence_bundle_id",
    "source_strategy_observation_noop_summary_id",
    "source_strategy_definition_id",
    "source_strategy_run_intent_id",
    "replay_mode",
    "run_mode",
    "allowed_processing_inputs",
    "allowed_processing_outputs",
    "forbidden_processing_outputs",
    "processing_rules",
    "status",
    "reason"
  ],
  "properties": {
    "strategy_observation_processing_contract_id": { "type": "string", "pattern": "^sopc_[a-f0-9]{32}$" },
    "schema_version": { "const": "strategy_observation_processing_contract.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "strategy_definition_id": { "type": "string", "pattern": "^sdef_" },
    "strategy_run_intent_id": { "type": "string", "pattern": "^sri_" },
    "strategy_observation_stack_closeout_checkpoint_id": { "type": "string", "pattern": "^soscc_" },
    "replay_mode": { "const": "offline_fixture_replay" },
    "run_mode": { "enum": ["validation_only", "dry_run_planned"] },
    "allowed_processing_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "strategy_observation_contract",
          "strategy_observation_input_set",
          "strategy_observation_trace",
          "strategy_observation_noop_summary",
          "strategy_observation_evidence_bundle",
          "strategy_observation_case_file_summary",
          "strategy_observation_stack_closeout_checkpoint"
        ]
      }
    },
    "allowed_processing_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "observation_processing_trace",
          "observation_processing_noop_summary",
          "observation_processing_evidence_bundle",
          "observation_processing_case_file_summary"
        ]
      }
    },
    "forbidden_processing_outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "processing_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "read_only_inputs",
          "preserve_source_provenance",
          "emit_processing_metadata_only",
          "no_signal_generation",
          "no_decision_generation",
          "no_trade_generation",
          "no_recommendations",
          "no_bankroll_outputs",
          "no_analytics",
          "no_network"
        ]
      }
    },
    "status": { "enum": ["strategy_observation_processing_contract_ready", "strategy_observation_processing_contract_rejected"] },
    "reason": { "type": "string" }
  }
}
