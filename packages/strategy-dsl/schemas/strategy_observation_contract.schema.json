{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overlord.strategy_observation_contract.schema.json",
  "title": "StrategyObservationContract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "strategy_observation_contract_id",
    "schema_version",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "strategy_definition_id",
    "strategy_run_intent_id",
    "strategy_dry_run_stack_closeout_checkpoint_id",
    "source_strategy_dry_run_stack_closeout_checkpoint_id",
    "source_strategy_dry_run_case_file_summary_id",
    "source_strategy_dry_run_evidence_bundle_id",
    "source_strategy_dry_run_trace_ids",
    "source_strategy_definition_id",
    "source_strategy_run_intent_id",
    "replay_mode",
    "run_mode",
    "allowed_observation_inputs",
    "forbidden_observation_outputs",
    "observation_rules",
    "status",
    "reason"
  ],
  "properties": {
    "strategy_observation_contract_id": { "type": "string", "pattern": "^soc_[a-f0-9]{32}$" },
    "schema_version": { "const": "strategy_observation_contract.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "strategy_definition_id": { "type": "string", "pattern": "^sdef_" },
    "strategy_run_intent_id": { "type": "string", "pattern": "^sri_" },
    "strategy_dry_run_stack_closeout_checkpoint_id": { "type": "string", "pattern": "^sdrscc_" },
    "source_strategy_dry_run_trace_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^sdrt_" }
    },
    "replay_mode": { "const": "offline_fixture_replay" },
    "run_mode": { "enum": ["validation_only", "dry_run_planned"] },
    "allowed_observation_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "strategy_definition",
          "strategy_run_intent",
          "strategy_dry_run_trace",
          "strategy_dry_run_noop_summary",
          "strategy_dry_run_case_file_summary",
          "replay_trace",
          "replay_clock",
          "replay_read_plan",
          "market_state_metadata"
        ]
      }
    },
    "forbidden_observation_outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "observation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "read_only_inputs",
          "preserve_source_provenance",
          "emit_observation_metadata_only",
          "no_signal_generation",
          "no_decision_generation",
          "no_trade_generation",
          "no_recommendations",
          "no_bankroll_outputs",
          "no_network"
        ]
      }
    },
    "status": { "enum": ["strategy_observation_contract_ready", "strategy_observation_contract_rejected"] },
    "reason": { "type": "string" }
  }
}
