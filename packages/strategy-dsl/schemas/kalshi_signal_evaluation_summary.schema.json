{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kalshi_signal_evaluation_summary.schema.json",
  "title": "KalshiSignalEvaluationSummary",
  "description": "A non-actionable evaluation of whether a Phase 4M market snapshot satisfies Phase 4N signal definition thresholds. Phase 4O only. Emits nothing. No signals, recommendations, decisions, orders, or paper ledger entries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kalshi_signal_evaluation_summary_id",
    "schema_version",
    "generated_at",
    "evaluation_mode",
    "source_phase",
    "signal_definition_id",
    "signal_definition_schema_version",
    "market_snapshot_id",
    "market_snapshot_schema_version",
    "condition_family",
    "input_artifact_refs",
    "evaluated_thresholds",
    "evaluation_status",
    "data_quality_status",
    "research_summary",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "credentials_used",
    "network_request_used",
    "emits_signal_events",
    "emits_recommendations",
    "emits_decisions",
    "emits_orders",
    "emits_paper_ledger_entries",
    "reason_code",
    "reason"
  ],
  "properties": {
    "kalshi_signal_evaluation_summary_id": {
      "type": "string",
      "pattern": "^kses_[a-f0-9]{32}$",
      "description": "Deterministic SHA-256 ID. Prefix kses_."
    },
    "schema_version": {
      "const": "kalshi_signal_evaluation_summary.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evaluation_mode": {
      "const": "local_fixture_evaluation_only",
      "description": "Phase 4O only supports local fixture evaluation. No live data."
    },
    "source_phase": {
      "const": "Phase 4O"
    },
    "signal_definition_id": {
      "type": "string",
      "pattern": "^kssd_[a-f0-9]{32}$",
      "description": "References the Phase 4N KalshiStrategySignalDefinition."
    },
    "signal_definition_schema_version": {
      "const": "kalshi_strategy_signal_definition.v1"
    },
    "market_snapshot_id": {
      "type": "string",
      "pattern": "^kms_[a-f0-9]{32}$",
      "description": "References the Phase 4M KalshiMarketSnapshot."
    },
    "market_snapshot_schema_version": {
      "const": "kalshi_market_snapshot.v1"
    },
    "condition_family": {
      "const": "descriptive_market_movement",
      "description": "Phase 4O only supports the descriptive_market_movement condition family."
    },
    "input_artifact_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_definition", "market_snapshot"],
      "properties": {
        "signal_definition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "schema_version"],
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^kssd_[a-f0-9]{32}$"
            },
            "schema_version": {
              "const": "kalshi_strategy_signal_definition.v1"
            }
          }
        },
        "market_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "schema_version"],
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^kms_[a-f0-9]{32}$"
            },
            "schema_version": {
              "const": "kalshi_market_snapshot.v1"
            }
          }
        }
      }
    },
    "evaluated_thresholds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "threshold_name",
          "threshold_value",
          "comparison",
          "data_source_field",
          "observed_value",
          "required_for_evaluation",
          "status",
          "passed"
        ],
        "properties": {
          "threshold_name": { "type": "string", "minLength": 1 },
          "threshold_value": { "type": "number" },
          "comparison": { "type": "string", "enum": ["lte", "gte"] },
          "data_source_field": {
            "type": "string",
            "enum": [
              "yes_ask_cents_minus_yes_bid_cents",
              "volume",
              "open_interest",
              "generated_at"
            ]
          },
          "observed_value": { "type": "number" },
          "required_for_evaluation": { "type": "boolean" },
          "status": { "const": "evaluated" },
          "passed": { "type": "boolean" }
        }
      }
    },
    "evaluation_status": {
      "const": "evaluated_non_actionable",
      "description": "Phase 4O results are always non-actionable. No downstream execution permitted."
    },
    "data_quality_status": {
      "const": "complete"
    },
    "research_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thresholds_evaluated_count",
        "thresholds_passed_count",
        "thresholds_failed_count",
        "evaluation_complete"
      ],
      "properties": {
        "thresholds_evaluated_count": { "type": "integer", "minimum": 0 },
        "thresholds_passed_count": { "type": "integer", "minimum": 0 },
        "thresholds_failed_count": { "type": "integer", "minimum": 0 },
        "evaluation_complete": { "type": "boolean" }
      }
    },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "credentials_used": { "const": false },
    "network_request_used": { "const": false },
    "emits_signal_events": {
      "const": false,
      "description": "Phase 4O does not emit signal events."
    },
    "emits_recommendations": {
      "const": false,
      "description": "Phase 4O does not emit recommendations."
    },
    "emits_decisions": {
      "const": false,
      "description": "Phase 4O does not emit decisions."
    },
    "emits_orders": {
      "const": false,
      "description": "Phase 4O does not emit orders."
    },
    "emits_paper_ledger_entries": {
      "const": false,
      "description": "Phase 4O does not emit paper ledger entries."
    },
    "reason_code": {
      "const": "EVALUATION_COMPLETE_NON_ACTIONABLE"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
