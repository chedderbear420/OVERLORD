{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/strategy-dsl/strategy_noop_run_summary.schema.json",
  "title": "Overlord StrategyNoOpRunSummary",
  "type": "object",
  "required": [
    "strategy_noop_run_summary_id",
    "schema_version",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "strategy_definition_id",
    "strategy_run_intent_id",
    "source_replay_run_manifest_id",
    "source_replay_evidence_bundle_id",
    "source_replay_clock_id",
    "source_replay_read_plan_id",
    "replay_mode",
    "run_mode",
    "total_trace_records",
    "total_inputs_observed",
    "status",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "strategy_noop_run_summary_id": { "type": "string", "pattern": "^sns_" },
    "schema_version": { "const": "strategy_noop_run_summary.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "strategy_definition_id": { "type": "string", "pattern": "^sdef_" },
    "strategy_run_intent_id": { "type": "string", "pattern": "^sri_" },
    "source_replay_run_manifest_id": { "type": "string", "pattern": "^rrm_" },
    "source_replay_evidence_bundle_id": { "type": "string", "pattern": "^reb_" },
    "source_replay_clock_id": { "type": "string", "pattern": "^rclk_" },
    "source_replay_read_plan_id": { "type": "string", "pattern": "^rrp_" },
    "replay_mode": { "enum": ["offline_fixture_replay"] },
    "run_mode": { "enum": ["validation_only", "dry_run_planned"] },
    "total_trace_records": { "type": "integer", "minimum": 0 },
    "total_inputs_observed": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["strategy_noop_summary_ready", "strategy_noop_summary_rejected"] },
    "reason": { "type": "string" }
  }
}
