{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overlord.strategy_observation_noop_summary.schema.json",
  "title": "StrategyObservationNoOpSummary",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "strategy_observation_noop_summary_id",
    "schema_version",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "strategy_observation_contract_id",
    "strategy_observation_input_set_id",
    "strategy_dry_run_stack_closeout_checkpoint_id",
    "replay_mode",
    "run_mode",
    "total_trace_records",
    "total_inputs_observed",
    "status",
    "reason"
  ],
  "properties": {
    "strategy_observation_noop_summary_id": { "type": "string", "pattern": "^sons_[a-f0-9]{32}$" },
    "schema_version": { "const": "strategy_observation_noop_summary.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "strategy_observation_contract_id": { "type": "string", "pattern": "^soc_" },
    "strategy_observation_input_set_id": { "type": "string", "pattern": "^sois_" },
    "strategy_dry_run_stack_closeout_checkpoint_id": { "type": "string", "pattern": "^sdrscc_" },
    "replay_mode": { "const": "offline_fixture_replay" },
    "run_mode": { "enum": ["validation_only", "dry_run_planned"] },
    "total_trace_records": { "type": "integer", "minimum": 0 },
    "total_inputs_observed": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["observation_noop_summary_ready", "observation_noop_summary_rejected"] },
    "reason": { "type": "string" }
  }
}
