{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/strategy-dsl/strategy_dry_run_trace.schema.json",
  "title": "Overlord StrategyDryRunTrace",
  "type": "object",
  "required": [
    "strategy_dry_run_trace_id",
    "schema_version",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "strategy_dry_run_readiness_checkpoint_id",
    "strategy_dry_run_plan_id",
    "strategy_dry_run_plan_evidence_summary_id",
    "strategy_definition_id",
    "strategy_run_intent_id",
    "source_strategy_definition_id",
    "source_strategy_run_intent_id",
    "source_strategy_run_manifest_id",
    "source_strategy_run_evidence_bundle_id",
    "replay_mode",
    "run_mode",
    "trace_event_type",
    "trace_index",
    "planned_observation_step",
    "observed_artifact_type",
    "observed_artifact_ref",
    "status",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "strategy_dry_run_trace_id": { "type": "string", "pattern": "^sdrt_" },
    "schema_version": { "const": "strategy_dry_run_trace.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "strategy_dry_run_readiness_checkpoint_id": { "type": "string", "pattern": "^sdrpc_" },
    "strategy_dry_run_plan_id": { "type": "string", "pattern": "^sdrp_" },
    "strategy_dry_run_plan_evidence_summary_id": { "type": "string", "pattern": "^sdrpes_" },
    "strategy_definition_id": { "type": "string", "pattern": "^sdef_" },
    "strategy_run_intent_id": { "type": "string", "pattern": "^sri_" },
    "source_strategy_definition_id": { "type": "string", "pattern": "^sdef_" },
    "source_strategy_run_intent_id": { "type": "string", "pattern": "^sri_" },
    "source_strategy_run_manifest_id": { "type": "string", "pattern": "^srm_" },
    "source_strategy_run_evidence_bundle_id": { "type": "string", "pattern": "^sreb_" },
    "replay_mode": { "enum": ["offline_fixture_replay"] },
    "run_mode": { "enum": ["validation_only", "dry_run_planned"] },
    "trace_event_type": {
      "enum": [
        "noop_dry_run_started",
        "noop_dry_run_step_observed",
        "noop_dry_run_completed",
        "noop_dry_run_rejected"
      ]
    },
    "trace_index": { "type": "integer", "minimum": 0 },
    "planned_observation_step": { "type": ["object", "null"] },
    "observed_artifact_type": { "type": ["string", "null"] },
    "observed_artifact_ref": { "type": "string" },
    "status": { "enum": ["dry_run_trace_recorded", "dry_run_trace_rejected"] },
    "reason": { "type": "string" }
  }
}
