{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/strategy-dsl/strategy_dry_run_plan_evidence_summary.schema.json",
  "title": "Overlord StrategyDryRunPlanEvidenceSummary",
  "type": "object",
  "required": [
    "strategy_dry_run_plan_evidence_summary_id",
    "schema_version",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "strategy_dry_run_plan_id",
    "strategy_definition_id",
    "strategy_run_intent_id",
    "strategy_run_manifest_id",
    "strategy_run_evidence_bundle_id",
    "source_strategy_dry_run_plan_id",
    "source_strategy_definition_id",
    "source_strategy_run_intent_id",
    "source_strategy_run_manifest_id",
    "source_strategy_run_evidence_bundle_id",
    "replay_mode",
    "run_mode",
    "allowed_input_artifact_count",
    "forbidden_output_count",
    "planned_observation_step_count",
    "safety_constraint_count",
    "validation_status",
    "status",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "strategy_dry_run_plan_evidence_summary_id": { "type": "string", "pattern": "^sdrpes_" },
    "schema_version": { "const": "strategy_dry_run_plan_evidence_summary.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "strategy_dry_run_plan_id": { "type": "string", "pattern": "^sdrp_" },
    "strategy_definition_id": { "type": "string", "pattern": "^sdef_" },
    "strategy_run_intent_id": { "type": "string", "pattern": "^sri_" },
    "strategy_run_manifest_id": { "type": "string", "pattern": "^srm_" },
    "strategy_run_evidence_bundle_id": { "type": "string", "pattern": "^sreb_" },
    "source_strategy_dry_run_plan_id": { "type": "string", "pattern": "^sdrp_" },
    "source_strategy_definition_id": { "type": "string", "pattern": "^sdef_" },
    "source_strategy_run_intent_id": { "type": "string", "pattern": "^sri_" },
    "source_strategy_run_manifest_id": { "type": "string", "pattern": "^srm_" },
    "source_strategy_run_evidence_bundle_id": { "type": "string", "pattern": "^sreb_" },
    "replay_mode": { "enum": ["offline_fixture_replay"] },
    "run_mode": { "enum": ["validation_only", "dry_run_planned"] },
    "allowed_input_artifact_count": { "type": "integer", "minimum": 0 },
    "forbidden_output_count": { "type": "integer", "minimum": 0 },
    "planned_observation_step_count": { "type": "integer", "minimum": 0 },
    "safety_constraint_count": { "type": "integer", "minimum": 0 },
    "validation_status": { "enum": ["validation_passed", "validation_failed", "validation_not_applicable"] },
    "status": { "enum": ["dry_run_plan_evidence_summary_ready", "dry_run_plan_evidence_summary_rejected"] },
    "reason": { "type": "string" }
  }
}
