{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overlord.strategy_observation_trace.schema.json",
  "title": "StrategyObservationTrace",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "strategy_observation_trace_id",
    "schema_version",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "strategy_observation_contract_id",
    "strategy_observation_input_set_id",
    "strategy_dry_run_stack_closeout_checkpoint_id",
    "strategy_definition_id",
    "strategy_run_intent_id",
    "replay_mode",
    "run_mode",
    "trace_event_type",
    "trace_index",
    "observed_input_type",
    "observed_artifact_path",
    "observed_record_count",
    "status",
    "reason"
  ],
  "properties": {
    "strategy_observation_trace_id": { "type": "string", "pattern": "^sot_[a-f0-9]{32}$" },
    "schema_version": { "const": "strategy_observation_trace.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "strategy_observation_contract_id": { "type": "string", "pattern": "^soc_" },
    "strategy_observation_input_set_id": { "type": "string", "pattern": "^sois_" },
    "strategy_dry_run_stack_closeout_checkpoint_id": { "type": "string", "pattern": "^sdrscc_" },
    "strategy_definition_id": { "type": "string", "pattern": "^sdef_" },
    "strategy_run_intent_id": { "type": "string", "pattern": "^sri_" },
    "replay_mode": { "const": "offline_fixture_replay" },
    "run_mode": { "enum": ["validation_only", "dry_run_planned"] },
    "trace_event_type": {
      "enum": [
        "noop_observation_started",
        "noop_observation_input_seen",
        "noop_observation_completed",
        "noop_observation_rejected"
      ]
    },
    "trace_index": { "type": "integer", "minimum": 0 },
    "observed_input_type": {
      "type": ["string", "null"],
      "enum": [
        "strategy_definition",
        "strategy_run_intent",
        "strategy_dry_run_trace",
        "strategy_dry_run_noop_summary",
        "strategy_dry_run_case_file_summary",
        "replay_trace",
        "replay_clock",
        "replay_read_plan",
        "market_state_metadata",
        null
      ]
    },
    "observed_artifact_path": { "type": ["string", "null"] },
    "observed_record_count": { "type": ["integer", "null"], "minimum": 0 },
    "status": { "enum": ["observation_trace_recorded", "observation_trace_rejected"] },
    "reason": { "type": "string" }
  }
}
