{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/strategy-dsl/strategy_observation_stack_closeout_checkpoint.schema.json",
  "title": "Overlord StrategyObservationStackCloseoutCheckpoint",
  "type": "object",
  "required": [
    "strategy_observation_stack_closeout_checkpoint_id",
    "schema_version",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "source_strategy_observation_contract_id",
    "source_strategy_observation_input_set_id",
    "source_strategy_observation_noop_summary_id",
    "source_strategy_observation_evidence_bundle_id",
    "source_strategy_observation_case_file_summary_id",
    "source_strategy_dry_run_stack_closeout_checkpoint_id",
    "source_strategy_definition_id",
    "source_strategy_run_intent_id",
    "replay_mode",
    "run_mode",
    "closeout_artifacts",
    "closeout_checks",
    "consistency_status",
    "freeze_recommendation",
    "status",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "strategy_observation_stack_closeout_checkpoint_id": { "type": "string", "pattern": "^soscc_" },
    "schema_version": { "const": "strategy_observation_stack_closeout_checkpoint.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "source_strategy_observation_contract_id": { "type": "string", "pattern": "^soc_" },
    "source_strategy_observation_input_set_id": { "type": "string", "pattern": "^sois_" },
    "source_strategy_observation_noop_summary_id": { "type": "string", "pattern": "^sons_" },
    "source_strategy_observation_evidence_bundle_id": { "type": "string", "pattern": "^soeb_" },
    "source_strategy_observation_case_file_summary_id": { "type": "string", "pattern": "^socfs_" },
    "source_strategy_dry_run_stack_closeout_checkpoint_id": { "type": "string", "pattern": "^sdrscc_" },
    "source_strategy_definition_id": { "type": "string", "pattern": "^sdef_" },
    "source_strategy_run_intent_id": { "type": "string", "pattern": "^sri_" },
    "replay_mode": { "enum": ["offline_fixture_replay"] },
    "run_mode": { "enum": ["validation_only", "dry_run_planned"] },
    "closeout_artifacts": { "type": "array", "minItems": 1 },
    "closeout_checks": { "type": "array", "minItems": 1 },
    "consistency_status": { "enum": ["consistency_passed", "consistency_failed", "consistency_not_applicable"] },
    "freeze_recommendation": { "enum": ["freeze_ready", "freeze_not_ready", "freeze_not_applicable"] },
    "status": { "enum": ["observation_stack_closeout_ready", "observation_stack_closeout_rejected"] },
    "reason": { "type": "string" }
  }
}
