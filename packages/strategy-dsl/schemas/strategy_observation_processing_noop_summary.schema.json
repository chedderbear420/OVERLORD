{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overlord.strategy_observation_processing_noop_summary.schema.json",
  "title": "StrategyObservationProcessingNoopSummary",
  "description": "A single-record JSON artifact closing out a no-op observation processing run. Records metadata about what was seen. Produces no signals, decisions, recommendations, analytics, or execution outputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strategy_observation_processing_noop_summary_id",
    "schema_version",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "strategy_observation_processing_contract_id",
    "strategy_observation_processing_input_set_id",
    "strategy_observation_stack_closeout_checkpoint_id",
    "source_strategy_observation_processing_contract_id",
    "source_strategy_observation_processing_input_set_id",
    "source_strategy_observation_stack_closeout_checkpoint_id",
    "source_strategy_definition_id",
    "source_strategy_run_intent_id",
    "replay_mode",
    "run_mode",
    "total_trace_records",
    "total_inputs_observed",
    "status",
    "reason"
  ],
  "properties": {
    "strategy_observation_processing_noop_summary_id": { "type": "string", "pattern": "^sopns_[a-f0-9]{32}$" },
    "schema_version": { "const": "strategy_observation_processing_noop_summary.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "strategy_observation_processing_contract_id": { "type": "string", "pattern": "^sopc_" },
    "strategy_observation_processing_input_set_id": { "type": "string", "pattern": "^sopis_" },
    "strategy_observation_stack_closeout_checkpoint_id": { "type": "string", "pattern": "^soscc_" },
    "source_strategy_observation_processing_contract_id": { "type": "string", "pattern": "^sopc_" },
    "source_strategy_observation_processing_input_set_id": { "type": "string", "pattern": "^sopis_" },
    "source_strategy_observation_stack_closeout_checkpoint_id": { "type": "string", "pattern": "^soscc_" },
    "source_strategy_definition_id": { "type": "string", "pattern": "^sdef_" },
    "source_strategy_run_intent_id": { "type": "string", "pattern": "^sri_" },
    "replay_mode": { "const": "offline_fixture_replay" },
    "run_mode": { "enum": ["validation_only", "dry_run_planned"] },
    "total_trace_records": { "type": "integer", "minimum": 0 },
    "total_inputs_observed": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["processing_noop_summary_ready", "processing_noop_summary_rejected"] },
    "reason": { "type": "string", "minLength": 1 }
  }
}
