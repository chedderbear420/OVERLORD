{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overlord.strategy_observation_processing_input_set.schema.json",
  "title": "StrategyObservationProcessingInputSet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strategy_observation_processing_input_set_id",
    "schema_version",
    "generated_at",
    "paper_only",
    "live_execution_allowed",
    "order_placement_allowed",
    "strategy_observation_processing_contract_id",
    "strategy_observation_stack_closeout_checkpoint_id",
    "source_strategy_observation_stack_closeout_checkpoint_id",
    "source_strategy_observation_case_file_summary_id",
    "source_strategy_observation_evidence_bundle_id",
    "source_strategy_observation_noop_summary_id",
    "source_strategy_definition_id",
    "source_strategy_run_intent_id",
    "replay_mode",
    "run_mode",
    "input_artifacts",
    "status",
    "reason_code",
    "reason"
  ],
  "properties": {
    "strategy_observation_processing_input_set_id": { "type": "string", "pattern": "^sopis_[a-f0-9]{32}$" },
    "schema_version": { "const": "strategy_observation_processing_input_set.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "paper_only": { "const": true },
    "live_execution_allowed": { "const": false },
    "order_placement_allowed": { "const": false },
    "strategy_observation_processing_contract_id": { "type": "string", "pattern": "^sopc_" },
    "strategy_observation_stack_closeout_checkpoint_id": { "type": "string", "pattern": "^soscc_" },
    "replay_mode": { "const": "offline_fixture_replay" },
    "run_mode": { "enum": ["validation_only", "dry_run_planned"] },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_type", "artifact_path", "artifact_id", "record_count", "access_mode"],
        "properties": {
          "artifact_type": {
            "enum": [
              "strategy_observation_contract",
              "strategy_observation_input_set",
              "strategy_observation_trace",
              "strategy_observation_noop_summary",
              "strategy_observation_evidence_bundle",
              "strategy_observation_case_file_summary",
              "strategy_observation_stack_closeout_checkpoint"
            ]
          },
          "artifact_path": { "type": "string" },
          "artifact_id": { "type": ["string", "null"] },
          "record_count": { "type": "integer", "minimum": 0 },
          "access_mode": { "const": "read_only" }
        }
      }
    },
    "status": { "enum": ["strategy_observation_processing_input_set_ready", "strategy_observation_processing_input_set_rejected"] },
    "reason_code": { "enum": ["VALIDATION_PASSED"] },
    "reason": { "type": "string" }
  }
}
