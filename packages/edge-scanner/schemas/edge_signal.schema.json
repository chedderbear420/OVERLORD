{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/edge-scanner/edge_signal.schema.json",
  "title": "Overlord EdgeSignal",
  "description": "Descriptive offline candidate signal with fee-aware net edge. Not an order and not a trade recommendation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signal_id",
    "schema_version",
    "source_state_id",
    "source_event_id",
    "source_payload_hash",
    "market_id",
    "captured_at",
    "received_at",
    "side",
    "observed_price",
    "model_id",
    "model_version",
    "model_probability",
    "raw_edge",
    "estimated_fee_cost",
    "estimated_spread_cost",
    "estimated_slippage_cost",
    "uncertainty_penalty",
    "net_edge",
    "liquidity_status",
    "staleness_status",
    "quality_flags",
    "edge_status",
    "risk_status",
    "action_eligibility",
    "reason"
  ],
  "properties": {
    "signal_id": { "type": "string", "pattern": "^sig_[A-Za-z0-9._:-]+$" },
    "schema_version": { "type": "string", "const": "edge_signal.v1" },
    "source_state_id": { "type": "string", "pattern": "^ms_[A-Za-z0-9._:-]+$" },
    "source_event_id": { "type": "string", "pattern": "^evt_[A-Za-z0-9._:-]+$" },
    "source_payload_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "market_id": { "type": "string" },
    "captured_at": { "type": "string", "format": "date-time" },
    "received_at": { "type": "string", "format": "date-time" },
    "side": { "type": "string", "enum": ["YES", "NO"] },
    "observed_price": { "type": "integer", "minimum": 0, "maximum": 100 },
    "model_id": { "type": "string" },
    "model_version": { "type": "string" },
    "model_probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "raw_edge": { "type": "number" },
    "estimated_fee_cost": { "type": "number", "minimum": 0 },
    "estimated_spread_cost": { "type": "number", "minimum": 0 },
    "estimated_slippage_cost": { "type": "number", "minimum": 0 },
    "uncertainty_penalty": { "type": "number", "minimum": 0 },
    "net_edge": { "type": "number" },
    "liquidity_status": { "type": "string" },
    "staleness_status": { "type": "string" },
    "quality_flags": { "type": "array", "items": { "type": "string" } },
    "edge_status": { "type": "string", "enum": ["positive", "negative", "zero_or_insufficient", "rejected"] },
    "risk_status": { "type": "string", "const": "not_evaluated" },
    "action_eligibility": { "type": "string", "enum": ["candidate_only", "rejected", "paper_eligible_candidate"] },
    "reason": { "type": "string" }
  }
}
