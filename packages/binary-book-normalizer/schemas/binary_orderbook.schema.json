{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overlord.local/schemas/binary-book-normalizer/binary_orderbook.schema.json",
  "title": "Overlord Synthetic Binary Order Book",
  "description": "Offline synthetic YES/NO bid book input for binary market normalization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "market_id",
    "source_event_id",
    "captured_at",
    "received_at",
    "yes_bids",
    "no_bids"
  ],
  "properties": {
    "market_id": {
      "type": "string",
      "minLength": 1
    },
    "source_event_id": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9._:-]+$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "yes_bids": {
      "$ref": "#/$defs/side_book"
    },
    "no_bids": {
      "$ref": "#/$defs/side_book"
    }
  },
  "$defs": {
    "price_level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "price_cents",
        "quantity"
      ],
      "properties": {
        "price_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "quantity": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "side_book": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/price_level"
      }
    }
  }
}
